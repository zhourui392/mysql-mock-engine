<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.vv.test</groupId>
        <artifactId>mysql-mock-engine</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>mysql-mock-compatibility-tests</artifactId>
    <name>mysql-mock-compatibility-tests</name>
    <description>消费方视角验证：jupiter 5.10.2 + mockito 2.23.4 + MyBatis-Plus 3.4.3.4；字节码门禁与 shade 零新增断言</description>

    <dependencies>
        <!-- 消费方依赖形态（test 域），对应方案 §4 兼容矩阵两档；
             exclusions 截断 reactor 形态下的内部模块传递链（SS/groovy 原始坐标），
             确保 Boot 用例与消费方一致只面对 shaded uber -->
        <dependency>
            <groupId>cn.vv.test</groupId>
            <artifactId>mysql-mock-spring-boot-starter</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion><groupId>cn.vv.test</groupId><artifactId>mysql-mock-spring-boot-autoconfigure</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cn.vv.test</groupId><artifactId>mysql-mock-spring-boot-autoconfigure</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion><groupId>cn.vv.test</groupId><artifactId>mysql-mock-junit5</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cn.vv.test</groupId><artifactId>mysql-mock-junit5</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion><groupId>cn.vv.test</groupId><artifactId>mysql-mock-mybatis</artifactId></exclusion>
                <exclusion><groupId>cn.vv.test</groupId><artifactId>mysql-mock-jdbc</artifactId></exclusion>
                <exclusion><groupId>cn.vv.test</groupId><artifactId>mysql-mock-calcite</artifactId></exclusion>
                <exclusion><groupId>cn.vv.test</groupId><artifactId>mysql-mock-schema</artifactId></exclusion>
                <exclusion><groupId>cn.vv.test</groupId><artifactId>mysql-mock-storage</artifactId></exclusion>
                <exclusion><groupId>cn.vv.test</groupId><artifactId>mysql-mock-api</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>2.1.3.RELEASE</version>
            <scope>test</scope>
        </dependency>
        <dependency><groupId>cn.vv.test</groupId><artifactId>mysql-mock-junit5</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mybatis</groupId><artifactId>mybatis</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-extension</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-annotation</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 差分用例默认跳过（需 docker 与 -Pcompat）；IT 命名（T14）一并纳入。
                         reactor 形态下内部模块传递链无视 exclusions 注入 classpath（Maven 已知行为），
                         排除原始 groovy 使 Spring 的 groovy 探测跳过（SS 解析门禁不依赖 groovy） -->
                    <excludedGroups>compat</excludedGroups>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.apache.groovy:groovy</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- D-09 差分兼容：同一 DDL/数据/SQL 与真实 MySQL 双跑，报告落 compatibility-report/ -->
        <profile>
            <id>compat</id>
            <dependencies>
                <dependency>
                    <groupId>mysql</groupId>
                    <artifactId>mysql-connector-java</artifactId>
                    <version>8.0.33</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups combine.self="override"/>
                            <groups>compat</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
