<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.vv.test</groupId>
        <artifactId>mysql-mock-engine</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>mysql-mock-mybatis</artifactId>
    <name>mysql-mock-mybatis</name>
    <description>无 Spring 的 MyBatis / MyBatis-Plus 装配助手（D-05 一等接入）；对外工件，shade 隔离（D-12）</description>

    <dependencies>
        <dependency><groupId>cn.vv.test</groupId><artifactId>mysql-mock-jdbc</artifactId></dependency>
        <!-- 消费方自带，不进 uber jar -->
        <dependency><groupId>org.mybatis</groupId><artifactId>mybatis</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-core</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-extension</artifactId><scope>provided</scope></dependency>
        <!-- buildSqlSessionTemplate() 出口：消费方（Spring Boot 服务）自带，缺失时该出口给出明确报错 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <version>2.0.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <version>5.1.5.RELEASE</version>
            <scope>provided</scope>
        </dependency>
        <!-- MP 3.4.3.4 的 mapper 注入路径需要 spring-core（MP 侧 optional，不随 provided 传递） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>5.1.20.RELEASE</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
